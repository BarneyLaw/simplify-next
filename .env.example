# Application mode: demo uses deterministic local adapters; live enables AWS/API clients.
ADAPTSG_MODE=demo
ADAPTSG_LOG_LEVEL=INFO

# Amazon Bedrock. Prefer an AWS profile locally; use short-lived environment credentials in CI/hosting.
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MAX_TOKENS=1200

# Replanning policy.
ADAPTSG_APPROVAL_COST_INCREASE_SGD=8
ADAPTSG_MAX_REPLANS=2
ADAPTSG_JOURNEY_TTL_HOURS=24

# Optional production persistence and external APIs.
ADAPTSG_JOURNEYS_TABLE=
ONEMAP_API_TOKEN=
ONEMAP_BFA_ENABLED=false
DATA_GOV_SG_API_KEY=
LTA_ACCOUNT_KEY=
ADAPTSG_AUTHENTICATION_MODE=demo
ADAPTSG_AUTHENTICATION_CONFIGURED=false
ADAPTSG_COGNITO_ISSUER=
ADAPTSG_COGNITO_AUDIENCE=
ADAPTSG_ENCRYPTION_CONFIGURED=false
ADAPTSG_AUDIT_STORAGE_CONFIGURED=false
ADAPTSG_PRODUCTION_RETENTION_CONFIGURED=false
ADAPTSG_AUDIT_RETENTION_DAYS=
ADAPTSG_REVOKED_CONSENT_RETENTION_DAYS=
ADAPTSG_CONSENT_POLICY_VERSION=
ADAPTSG_CONSENT_CATEGORIES=journey_input,mobility_accessibility,location_routing,provider_processing
ADAPTSG_CATALOG_VERSION=
ADAPTSG_LIVE_CATALOG_CONFIGURED=false
ADAPTSG_COST_MODEL_VERSION=
ADAPTSG_INPUT_TOKEN_TARIFF_SGD=
ADAPTSG_OUTPUT_TOKEN_TARIFF_SGD=

# Optional URL used by the Vercel static demo when the API is hosted elsewhere.
ADAPTSG_API_BASE_URL=
