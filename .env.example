# Application mode: demo uses deterministic local adapters; live enables AWS/API clients.
ADAPTSG_MODE=demo
ADAPTSG_LOG_LEVEL=INFO

# Amazon Bedrock. Prefer an AWS profile locally; use short-lived environment credentials in CI/hosting.
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MAX_TOKENS=1200

# Replanning policy.
ADAPTSG_APPROVAL_COST_INCREASE_SGD=8
ADAPTSG_MAX_REPLANS=2

# Optional production persistence and external APIs.
ADAPTSG_JOURNEYS_TABLE=
ONEMAP_API_TOKEN=
DATA_GOV_SG_API_KEY=

# Optional URL used by the Vercel static demo when the API is hosted elsewhere.
ADAPTSG_API_BASE_URL=

